# ---- storage ----
OPENRAG_DATA_DIR=data

# ---- embedding ----
# auto | hash | sentence-transformers | openai
# auto: use sentence-transformers when installed, otherwise the built-in hash embedder
OPENRAG_EMBEDDING_PROVIDER=auto
OPENRAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# only for provider=openai (any OpenAI-compatible endpoint: ollama, dashscope, deepseek ...)
OPENRAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENRAG_EMBEDDING_API_KEY=
OPENRAG_EMBEDDING_DIM=512

# ---- chunking (tokens) ----
OPENRAG_CHILD_TOKENS=320
OPENRAG_PARENT_TOKENS=1400
OPENRAG_CHUNK_OVERLAP=48
# optional: use tiktoken instead of the built-in heuristic counter
# OPENRAG_TOKENIZER=tiktoken

# ---- rerank (none | http | local) ----
OPENRAG_RERANK_PROVIDER=none
OPENRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
OPENRAG_RERANK_BASE_URL=http://127.0.0.1:8082/v1
OPENRAG_RERANK_PATH=/rerank
OPENRAG_RERANK_API_KEY=
OPENRAG_RERANK_TIMEOUT=30
OPENRAG_RERANK_CANDIDATES=30

# ---- retrieval filtering ----
# drop results below this absolute relevance score (0 disables)
OPENRAG_MIN_SCORE=0
# drop results below top_score * cutoff (0.75 keeps the head of the ranking)
OPENRAG_RELATIVE_CUTOFF=0.75
# max chunks per document, 0 = unlimited
OPENRAG_MAX_PER_DOC=0
# keep only the best child per parent block
OPENRAG_DEDUPE_PARENT=true

# ---- server ----
OPENRAG_HOST=127.0.0.1
OPENRAG_PORT=8000
OPENRAG_CORS_ORIGINS=*
OPENRAG_MAX_UPLOAD_MB=50
